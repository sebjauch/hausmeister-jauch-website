---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Seite nicht gefunden" noindex>
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="max-w-md text-center space-y-6">
      <span class="font-mono text-xs tracking-[0.3em] text-muted-foreground block">FEHLER 404</span>
      <h1 class="font-heading text-3xl lg:text-4xl font-bold text-primary">Seite nicht gefunden</h1>
      <p class="text-muted-foreground leading-relaxed">
        Diese Seite gibt es leider nicht (mehr). Auf der Startseite finden Sie alle Leistungen und das Kontaktformular.
      </p>
      <a
        href="/"
        class="inline-block bg-primary text-primary-foreground px-6 py-3 font-heading font-semibold text-sm tracking-wider uppercase hover:bg-primary/90 transition-colors"
      >
        Zur Startseite
      </a>
    </div>
  </main>
</BaseLayout>
